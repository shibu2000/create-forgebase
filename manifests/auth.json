{
  "name": "auth",
  "label": "Authentication",
  "description": "Login, refresh-token rotation, logout, and password reset over SMTP, with the authenticate/authorize guards every other module's routes depend on.",
  "requires": [
    "core",
    "services-password",
    "services-email",
    "user-role-action"
  ],
  "requiresOneOf": [
    "db-sequelize",
    "db-drizzle"
  ],
  "files": {
    "templates-<lang>/modules/auth": "src/modules/auth"
  },
  "variants": {
    "sequelize": {
      "models": [
        "auth.model.<ext>"
      ],
      "repositories": [
        "auth.repository.<ext>"
      ],
      "migrations": {
        "templates-<lang>/sequelize/db/migrations/20260101000100-create-auth-tokens.<ext>": "src/db/migrations/20260101000100-create-auth-tokens.<ext>"
      }
    },
    "drizzle": {
      "models": [
        "auth.model.<ext>"
      ],
      "repositories": [
        "auth.repository.<ext>"
      ],
      "migrations": {
        "templates-<lang>/drizzle/db/migrations/0001_auth_tokens.sql": "src/db/migrations/0001_auth_tokens.sql"
      }
    }
  },
  "dependencies": {
    "jose": "6.2.10"
  },
  "devDependencies": {},
  "scripts": {},
  "env": [
    {
      "key": "JWT_ACCESS_SECRET",
      "value": "",
      "comment": "REQUIRED, min 32 chars. Generate with: openssl rand -base64 48"
    },
    {
      "key": "JWT_ACCESS_TTL_SECONDS",
      "value": "900",
      "comment": "Access token lifetime (15 minutes)"
    },
    {
      "key": "REFRESH_TTL_SECONDS",
      "value": "2592000",
      "comment": "Refresh token lifetime (30 days)"
    },
    {
      "key": "PASSWORD_RESET_TTL_SECONDS",
      "value": "3600",
      "comment": "Password reset link lifetime (1 hour)"
    },
    {
      "key": "JWT_ISSUER",
      "value": "forgebase",
      "comment": "iss claim, verified on every request"
    },
    {
      "key": "JWT_AUDIENCE",
      "value": "forgebase-api",
      "comment": "aud claim, verified on every request"
    }
  ],
  "routes": [
    {
      "method": "POST",
      "path": "/auth/login",
      "action": null,
      "rateLimited": true
    },
    {
      "method": "POST",
      "path": "/auth/refresh",
      "action": null,
      "rateLimited": true
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "action": null
    },
    {
      "method": "POST",
      "path": "/auth/forgot-password",
      "action": null,
      "rateLimited": true
    },
    {
      "method": "POST",
      "path": "/auth/reset-password",
      "action": null,
      "rateLimited": true
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "action": null,
      "authenticated": true
    }
  ]
}
